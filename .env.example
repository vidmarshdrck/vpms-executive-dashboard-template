# Optional. Set one sign-in path. Never put a password in this file.
# Base path for a dedicated domain such as vidmar.tech is "/".
# VITE_BASE_PATH=/

# A) HTTPS endpoint that checks the password. POST JSON { "username", "password" }.
#    200 { "ok": true } accepts the account. Anything else is rejected.
#    Username administrator is the admin role.
# VITE_VHPMS_AUTH_URL=https://auth.example.com/vhpms/session

# B) Supabase Auth. Create the user in Supabase with the owner's own password.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_VHPMS_ADMIN_EMAIL=owner@vidmar.tech
# VITE_VHPMS_USER_EMAILS=nehemiah:nehemiah@vidmar.tech,barnabas:barnabas@vidmar.tech
