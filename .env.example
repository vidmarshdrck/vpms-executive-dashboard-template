# Optional. Set one sign-in path. Never put a password in this file.
# Base path for a dedicated domain such as vidmar.tech is "/".
# VITE_BASE_PATH=/

# A) HTTPS endpoint that checks the password. POST JSON { "username", "password" }.
#    200 { "ok": true } accepts the account. Anything else is rejected.
#    Username shadrickvidmar is the admin role.
#    200 { "ok": true } is the only accepted result. A token string may be included for later API calls.
# VITE_VHPMS_AUTH_URL=https://auth.example.com/vhpms/session

# B) Supabase Auth. The Supabase user for shadrickvidmar is created in Supabase.
#    The credential stays there. This file does not contain it.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_VHPMS_ADMIN_EMAIL=owner@vidmar.tech
# VITE_VHPMS_USER_EMAILS=nehemiah:nehemiah@vidmar.tech,barnabas:barnabas@vidmar.tech

# SMS transactions. Read and label only with the signed-in session.
# GET the URL with Authorization: Bearer <session token>
# 200 { "transactions": [ { "id", "received_at", "sender", "transaction_id", "amount", "direction", "counterparty", "raw_message", "business_id", "purpose" } ] }
# PATCH the same URL with { "id", "business_id", "purpose" } and require 200 { "ok": true }.
# Supabase alternative: table public.vhpms_sms_transactions with those columns.
# Row level security must allow select and update only for an authenticated session.
# The publishable key must not be able to read the table on its own.
# VITE_VHPMS_SMS_URL=https://auth.example.com/vhpms/sms
